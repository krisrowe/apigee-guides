<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ExternalCallout async="false" continueOnError="false" enabled="true" name="EC-OpaPolicy">
  <DisplayName>EC-OpaPolicy</DisplayName>
  <GrpcConnection>
    <Server name="opa-grpc-server"/>
  </GrpcConnection>
  <TimeoutMs>5000</TimeoutMs>
  <Configurations>
    <Property name="with.request.content">true</Property>
    <Property name="with.request.headers">true</Property>
    <FlowVariable>jwt.JWT-DecodeCaller.decoded.claim.sub</FlowVariable>
    <FlowVariable>jwt.JWT-DecodeCaller.decoded.claim.role</FlowVariable>
  </Configurations>
</ExternalCallout>
